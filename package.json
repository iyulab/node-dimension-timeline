{
  "name": "@iyulab/dimension-timeline",
  "description": "A timeline component for visualizing tasks across customizable dimensions with collision-aware layout",
  "version": "0.1.0",
  "keywords": [
    "iyulab",
    "timeline",
    "dimension",
    "gantt",
    "scheduler",
    "web-components",
    "lit",
    "canvas"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/dimension-timeline.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "start": "vite --force",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iyulab/components": "^0.2.0",
    "lit": "^3.3.2",
    "quill": "2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.0",
    "eslint": "^10.0.2",
    "eslint-plugin-lit": "^2.2.1",
    "globals": "^17.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
