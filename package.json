{
  "name": "@iyulab/dimension-timeline",
  "description": "A timeline component for visualizing tasks across customizable dimensions with collision-aware layout",
  "version": "0.3.2",
  "keywords": [
    "iyulab",
    "timeline",
    "dimension",
    "gantt",
    "scheduler",
    "web-components",
    "lit",
    "canvas"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/node-dimension-timeline.git"
  },
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "customElements": "./dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*"
    }
  },
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts",
    "./dist/components/**/*.js",
    "./src/components/**/*.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "start": "vite --force",
    "analyze": "cem analyze",
    "build": "npm run typecheck && eslint && vite build && npm run analyze",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@iyulab/components": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "@iyulab/components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@iyulab/components": "^3.0.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
