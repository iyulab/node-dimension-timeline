{
  "name": "@iyulab/dimension-timeline",
  "description": "A timeline component for visualizing tasks across customizable dimensions with collision-aware layout",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "iyulab",
    "timeline",
    "dimension",
    "gantt",
    "scheduler",
    "web-components",
    "lit",
    "canvas"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/dimension-timeline.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "preversion": "node ../../scripts/preversion-check.mjs",
    "start": "vite --force",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3"
  }
}
